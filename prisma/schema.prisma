// ------------------------------------------------------
// 17. INVENTORY & ASSETS (fixed assets, lab equipment, computer labs,
// consumable stock, purchase orders, vendor directory)
// ------------------------------------------------------

model Vendor {
  id            String   @id @default(uuid())
  institutionId String
  name          String
  category      String? // e.g. "IT Hardware", "Lab Instruments", "Stationery"
  gstNumber     String?
  phone         String?
  email         String?
  createdAt     DateTime @default(now())

  institution    Institution     @relation(fields: [institutionId], references: [id])
  purchaseOrders PurchaseOrder[]
  Asset          Asset[]
}

model Asset {
  id                 String    @id @default(uuid())
  institutionId      String
  assetTag           String
  name               String
  category           String // e.g. "Furniture", "IT Equipment", "Lab Instrument"
  location           String?
  quantity           Int       @default(1)
  condition          String    @default("GOOD") // GOOD, NEEDS_REPAIR, DAMAGED, DISPOSED
  purchaseDate       DateTime?
  purchaseValue      Float?
  calibrationDueDate DateTime? // only relevant for lab/scientific instruments
  vendorId           String?
  createdAt          DateTime  @default(now())

  institution Institution      @relation(fields: [institutionId], references: [id])
  vendor      Vendor?          @relation(fields: [vendorId], references: [id])
  issueLogs   EquipmentIssue[]

  @@unique([institutionId, assetTag])
}

// A single checkout/return record — who currently holds a piece of lab equipment, and when
// it was returned (null while still checked out).
model EquipmentIssue {
  id         String    @id @default(uuid())
  assetId    String
  studentId  String
  staffId    String
  quantity   Int       @default(1)
  issuedAt   DateTime  @default(now())
  returnedAt DateTime?
  remarks    String?

  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([studentId])
  @@index([staffId])
}

model ComputerLab {
  id              String   @id @default(uuid())
  institutionId   String
  labName         String
  pcCount         Int      @default(0)
  specifications  String?
  operatingSystem String?
  network         String?
  createdAt       DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
}

model StockItem {
  id            String   @id @default(uuid())
  institutionId String
  name          String
  category      String? // e.g. "Stationery", "AV Accessories", "Lab Consumables"
  unit          String   @default("Units")
  quantity      Int      @default(0)
  reorderLevel  Int      @default(10)
  location      String?
  createdAt     DateTime @default(now())

  institution  Institution        @relation(fields: [institutionId], references: [id])
  transactions StockTransaction[]
}

model StockTransaction {
  id          String   @id @default(uuid())
  stockItemId String
  type        String // IN, OUT
  quantity    Int
  reason      String?
  performedBy String?
  createdAt   DateTime @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id            String   @id @default(uuid())
  institutionId String
  poNumber      String   @unique
  vendorId      String
  items         String // free-text description of purchased items
  totalAmount   Float
  orderDate     DateTime @default(now())
  status        String   @default("ORDERED") // ORDERED, DELIVERED, CANCELLED
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  vendor      Vendor      @relation(fields: [vendorId], references: [id])
}

// ------------------------------------------------------
// 20. DYNAMIC REPORT ENGINE
//
// Three layers, matching the runtime architecture:
//   1. Catalog       — Report (+ ReportFilter, ReportColumn): what reports exist at all.
//   2. Configuration — InstitutionReport: which of those an institution can see/use, and how.
//   3. Engine        — implemented in code (shared/reportEngine), reads this metadata plus
//                       a per-report backend handler to build, run and export the report.
// ------------------------------------------------------

enum ReportCategory {
  STUDENT
  STAFF
  ACADEMIC
  ATTENDANCE
  EXAMINATION
  FEES
  FINANCE
  LIBRARY
  HOSTEL
  TRANSPORT
  ADMISSION
  COMMUNICATION
  ADMINISTRATION
  ANALYTICS
  CUSTOM
}

enum ReportStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ReportVisibility {
  SYSTEM // ships with SCOMS, available to every institution by default
  INSTITUTION // a custom report built for one specific institution
}

enum FilterInputType {
  TEXT
  NUMBER
  DATE
  DATE_RANGE
  SELECT
  MULTI_SELECT
  SEARCH_SELECT
  CHECKBOX
  RADIO
  BOOLEAN
  ACADEMIC_YEAR
  DEPARTMENT
  COURSE
  SEMESTER
  SECTION
  SUBJECT
  STUDENT
  STAFF
  PAYMENT_MODE
  STATUS
}

enum ReportRunStatus {
  SUCCESS
  FAILED
  RUNNING
}

enum ReportRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  IN_DEVELOPMENT
  READY
  REJECTED
}

/// Layer 1 — Report Catalog: "what reports exist in SCOMS?"
model Report {
  id             String           @id @default(uuid())
  code           String           @unique // e.g. STUDENT_LIST — also the handler registry key
  name           String
  description    String?
  category       ReportCategory
  module         String? // free-text grouping label, e.g. "Academics"
  icon           String? // lucide-react icon name, resolved client-side
  status         ReportStatus     @default(ACTIVE)
  visibility     ReportVisibility @default(SYSTEM)
  version        Int              @default(1)
  allowedRoles   Json? // RoleType[] as JSON, e.g. ["INSTITUTE_ADMIN","ACCOUNTANT"] — null = institute-admin only
  allowedFormats Json? // e.g. ["PREVIEW","PDF","EXCEL","CSV","PRINT"] — null = all formats
  handlerKey     String // key into the backend ReportRegistry; defaults to `code`
  createdById    String?
  updatedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  filters            ReportFilter[]
  columns            ReportColumn[]
  institutionReports InstitutionReport[]
  runs               ReportRun[]
  savedReports       SavedReport[]

  @@index([category])
  @@index([status])
}

/// One dynamic filter field belonging to a report — the frontend renders its whole form
/// from this list, never from hardcoded JSX per report.
model ReportFilter {
  id           String          @id @default(uuid())
  reportId     String
  fieldKey     String
  label        String
  inputType    FilterInputType
  dataType     String          @default("string") // string, number, date, boolean
  required     Boolean         @default(false)
  defaultValue String?
  placeholder  String?
  options      Json? // static option list, when not resolved dynamically from `source`
  source       String? // e.g. "ACADEMIC_YEAR" — resolved server-side, scoped to the caller's institution
  dependsOn    String? // fieldKey of the parent filter this one cascades from
  sortOrder    Int             @default(0)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

/// One output column belonging to a report — the result table is rendered generically from
/// whatever columns the report's handler + this configuration produce.
model ReportColumn {
  id          String  @id @default(uuid())
  reportId    String
  fieldKey    String
  label       String
  dataType    String  @default("string")
  visible     Boolean @default(true)
  sortable    Boolean @default(true)
  width       Int?
  format      String? // e.g. "currency", "date", "percentage"
  aggregation String? // COUNT, SUM, AVG, MIN, MAX, PERCENTAGE — included in the totals row
  sortOrder   Int     @default(0)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

/// Layer 2 — Report Configuration: "which institution can use this report, and how?"
model InstitutionReport {
  id             String   @id @default(uuid())
  institutionId  String
  reportId       String
  enabled        Boolean  @default(true)
  displayName    String? // overrides Report.name for this institution, if set
  description    String?
  sortOrder      Int      @default(0)
  allowedRoles   Json? // overrides Report.allowedRoles for this institution, if set
  allowedFormats Json?
  configuration  Json? // institution-level template customization (logo/footer toggles, etc.)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  report      Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([institutionId, reportId])
  @@index([institutionId])
}

/// Report History — every generate/export attempt, successful or not.
model ReportRun {
  id            String          @id @default(uuid())
  institutionId String
  reportId      String
  generatedById String?
  filters       Json?
  format        String          @default("PREVIEW")
  status        ReportRunStatus @default(SUCCESS)
  rowCount      Int?
  errorMessage  String?
  startedAt     DateTime        @default(now())
  completedAt   DateTime?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  report      Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([institutionId, reportId])
  @@index([startedAt])
}

/// A user's saved filter preset for one report, for one-click re-generation later.
model SavedReport {
  id            String   @id @default(uuid())
  institutionId String
  reportId      String
  userId        String
  name          String
  filters       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  report      Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([institutionId, reportId])
}

/// Institution → Super Admin workflow for reports that don't exist in the catalog yet.
model ReportRequest {
  id            String              @id @default(uuid())
  institutionId String
  requestedById String
  title         String
  category      ReportCategory
  description   String
  requirements  String?
  sampleFileUrl String?
  priority      String              @default("MEDIUM") // LOW, MEDIUM, HIGH
  status        ReportRequestStatus @default(REQUESTED)
  assignedToId  String?
  adminRemarks  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  requestedBy User        @relation("ReportRequestedBy", fields: [requestedById], references: [id])
  assignedTo  User?       @relation("ReportRequestAssignedTo", fields: [assignedToId], references: [id])

  @@index([institutionId])
  @@index([status])
}

// ------------------------------------------------------
// 21. DYNAMIC CERTIFICATE ENGINE
//
// Same three-layer shape as the Report Engine:
//   1. Catalog       — CertificateTemplate (+ CertificateField): what certificate types exist.
//   2. Configuration — InstitutionCertificateTemplate: each institution's own wording,
//                       header, signatory and branding toggles for a template.
//   3. Engine        — shared/certificateEngine: merges 1+2, substitutes real student data
//                       into the wording, and issues a real Certificate row.
// ------------------------------------------------------

enum CertificateStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum CertificateVisibility {
  SYSTEM // ships with SCOMS, available to every institution by default
  INSTITUTION // a custom certificate type built for one specific institution
}

/// Layer 1 — Certificate Catalog: "what certificate types exist in SCOMS?"
model CertificateTemplate {
  id           String                @id @default(uuid())
  code         String                @unique // e.g. BONAFIDE, TC, CONDUCT, COMPLETION, FEEPAID
  name         String
  description  String?
  category     String?
  icon         String?
  status       CertificateStatus     @default(ACTIVE)
  visibility   CertificateVisibility @default(SYSTEM)
  version      Int                   @default(1)
  headerTitle  String // default heading printed on the certificate, e.g. "BONAFIDE CERTIFICATE"
  bodyTemplate String // the certificate wording with {{fieldKey}} placeholders
  footerNote   String? // small print under the body, e.g. purpose disclaimer
  createdById  String?
  updatedById  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  fields               CertificateField[]
  institutionTemplates InstitutionCertificateTemplate[]
  certificates         Certificate[]

  @@index([status])
}

/// One placeholder used by a template's wording — the frontend renders a field for it only
/// when its source is MANUAL (collected at generation time); STUDENT/PARENT/INSTITUTION/
/// SYSTEM fields are resolved automatically by the engine from real records.
model CertificateField {
  id           String  @id @default(uuid())
  templateId   String
  fieldKey     String // matches a {{fieldKey}} placeholder in bodyTemplate
  label        String
  source       String  @default("STUDENT") // STUDENT, PARENT, INSTITUTION, MANUAL, SYSTEM
  inputType    String  @default("TEXT") // TEXT, DATE, SELECT, TEXTAREA — only used when source = MANUAL
  required     Boolean @default(false)
  options      Json?
  defaultValue String?
  sortOrder    Int     @default(0)

  template CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

/// Layer 2 — Certificate Configuration: "how does this institution issue this certificate?"
model InstitutionCertificateTemplate {
  id                   String   @id @default(uuid())
  institutionId        String
  templateId           String
  enabled              Boolean  @default(true)
  customHeaderTitle    String? // overrides Template.headerTitle for this institution, if set
  customBodyTemplate   String? // overrides Template.bodyTemplate for this institution, if set
  customFooterNote     String?
  showLogo             Boolean  @default(true)
  showSeal             Boolean  @default(true)
  showSignature        Boolean  @default(true)
  signatoryName        String?
  signatoryDesignation String?
  issuePlace           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  institution Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  template    CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([institutionId, templateId])
  @@index([institutionId])
}
