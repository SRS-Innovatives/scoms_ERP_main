// SCOMS - School & College Management System Database Schema
// Prisma Schema for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// 1. INSTITUTIONS & SAAS TENANCY
// ------------------------------------------------------

enum InstitutionType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  POLYTECHNIC
}

enum InstitutionStatus {
  ACTIVE
  PENDING
  SUSPENDED
  EXPIRED
}

model Institution {
  id                 String            @id @default(uuid())
  code               String            @unique
  name               String
  type               InstitutionType   @default(SCHOOL)
  registrationNumber String?
  gstin              String? // Institution's own GSTIN, used to compute CGST/SGST vs IGST on invoices
  affiliation        String?
  board              String?
  university         String?
  email              String
  phone              String
  website            String?
  logo               String?
  address            String
  city               String
  district           String?
  state              String
  pincode            String
  country            String            @default("India")
  principalName      String?
  establishedYear    Int?
  planName           String?
  modules            Json?
  status             InstitutionStatus @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  // Relations
  users                           User[]
  academicYears                   AcademicYear[]
  departments                     Department[]
  courses                         Course[]
  students                        Student[]
  staff                           Staff[]
  attendanceSessions              AttendanceSession[]
  leaveRequests                   LeaveRequest[]
  timetables                      Timetable[]
  assignments                     Assignment[]
  materials                       StudyMaterial[]
  questionBanks                   QuestionBank[]
  exams                           Exam[]
  feeStructures                   FeeStructure[]
  feePayments                     FeePayment[]
  feeReceipts                     FeeReceipt[]
  feeChallans                     FeeChallan[]
  feeRefunds                      FeeRefund[]
  books                           Book[]
  vehicles                        Vehicle[]
  routes                          TransportRoute[]
  hostels                         Hostel[]
  certificates                    Certificate[]
  announcements                   Announcement[]
  notifications                   Notification[]
  events                          Event[]
  clubs                           Club[]
  grievances                      Grievance[]
  auditLogs                       AuditLog[]
  subscriptions                   Subscription[]
  invoices                        Invoice[]
  supportTickets                  SupportTicket[]
  aiUsageLogs                     AiUsageLog[]
  smsLogs                         SmsLog[]
  smsWallet                       InstitutionSmsWallet?
  smsAllocations                  SmsAllocation[]
  emailLogs                       EmailLog[]
  emailWallet                     InstitutionEmailWallet?
  emailAllocations                EmailAllocation[]
  whatsappLogs                    WhatsappLog[]
  whatsappWallet                  InstitutionWhatsappWallet?
  whatsappAllocations             WhatsappAllocation[]
  vendors                         Vendor[]
  assets                          Asset[]
  computerLabs                    ComputerLab[]
  stockItems                      StockItem[]
  purchaseOrders                  PurchaseOrder[]
  settings                        InstitutionSettings?
  studentAchievements             StudentAchievement[]
  appointments                    Appointment[]
  jobPostings                     JobPosting[]
  parentMeetingNotes              ParentMeetingNote[]
  institutionReports              InstitutionReport[]
  reportRuns                      ReportRun[]
  savedReports                    SavedReport[]
  reportRequests                  ReportRequest[]
  institutionCertificateTemplates InstitutionCertificateTemplate[]
  feeCategories                   FeeCategory[]
  feeHeads                        FeeHead[]

  @@index([code])
  @@index([status])
}

// ------------------------------------------------------
// 2. USERS, ROLES & AUTHENTICATION
// ------------------------------------------------------

enum RoleType {
  SUPER_ADMIN
  PLATFORM_ADMIN
  INSTITUTE_ADMIN
  PRINCIPAL
  VICE_PRINCIPAL
  HOD
  TEACHER
  STAFF
  ACCOUNTANT
  LIBRARIAN
  TRANSPORT_MANAGER
  HOSTEL_WARDEN
  EXAM_ADMIN
  PLACEMENT_OFFICER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id              String     @id @default(uuid())
  institutionId   String?
  email           String?
  mobile          String?
  admissionNumber String?
  employeeCode    String?
  userCode        String?    @unique // professional, human-readable identity — e.g. "DPIS-STU-00002"; mirrors admissionNumber/employeeCode for Student/Staff, freshly generated for every other role
  password        String
  role            RoleType   @default(STUDENT)
  status          UserStatus @default(ACTIVE)
  avatar          String?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  // Relations
  institution           Institution?       @relation(fields: [institutionId], references: [id])
  student               Student?
  staff                 Staff?
  parent                Parent?
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  sentMessages          Message[]          @relation("SentMessages")
  announcements         Announcement[]
  passwordResetOtps     PasswordResetOtp[]
  savedReports          SavedReport[]
  reportRequestsMade    ReportRequest[]    @relation("ReportRequestedBy")
  reportRequestsHandled ReportRequest[]    @relation("ReportRequestAssignedTo")
  notifications         Notification[]

  @@unique([email])
  @@unique([mobile])
  @@index([institutionId, role])
  @@index([institutionId, status])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 3. ACADEMIC STRUCTURE
// ------------------------------------------------------

model AcademicYear {
  id            String   @id @default(uuid())
  institutionId String
  yearName      String // e.g. "2025-2026"
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution   Institution    @relation(fields: [institutionId], references: [id])
  semesters     Semester[]
  exams         Exam[]
  feeStructures FeeStructure[]

  @@unique([institutionId, yearName])
}

model Department {
  id            String   @id @default(uuid())
  institutionId String
  code          String
  name          String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])
  courses     Course[]
  staff       Staff[]
  students    Student[]

  @@unique([institutionId, code])
}

model Course {
  id            String   @id @default(uuid())
  institutionId String
  departmentId  String
  code          String
  name          String // e.g. "B.Tech Computer Science" or "Class 10"
  durationYears Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semesters     Semester[]
  students      Student[]
  subjects      Subject[]
  feeStructures FeeStructure[]
  announcements Announcement[]

  @@unique([institutionId, code])
}

model Semester {
  id             String   @id @default(uuid())
  courseId       String
  academicYearId String
  name           String // e.g. "Semester 1" or "Term 1"
  semesterNumber Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sections     Section[]

  @@unique([courseId, semesterNumber, academicYearId])
}

model Section {
  id             String   @id @default(uuid())
  semesterId     String
  name           String // e.g. "Section A"
  capacity       Int      @default(60)
  classTeacherId String? // the homeroom/class advisor — distinct from per-subject teachers below
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  semester           Semester                @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  classTeacher       Staff?                  @relation("SectionClassTeacher", fields: [classTeacherId], references: [id])
  students           Student[]
  attendanceSessions AttendanceSession[]
  timetables         Timetable[]
  announcements      Announcement[]
  teacherMappings    SubjectTeacherMapping[]
}

model Subject {
  id        String   @id @default(uuid())
  courseId  String
  code      String
  name      String
  type      String   @default("THEORY") // THEORY, PRACTICAL, LAB
  credits   Int      @default(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course             Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherMappings    SubjectTeacherMapping[]
  attendanceSessions AttendanceSession[]
  timetableEntries   TimetableEntry[]
  materials          StudyMaterial[]
  questionBanks      QuestionBank[]
  examSchedules      ExamSchedule[]
  courseFeedback     CourseFeedback[]

  @@unique([courseId, code])
}

model SubjectTeacherMapping {
  id        String   @id @default(uuid())
  subjectId String
  staffId   String
  sectionId String?
  createdAt DateTime @default(now())

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff   Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 4. STUDENTS & PARENTS
// ------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Student {
  id              String    @id @default(uuid())
  userId          String    @unique
  institutionId   String
  admissionNumber String
  registerNumber  String?
  rollNumber      String?
  firstName       String
  lastName        String
  dob             DateTime
  gender          Gender
  bloodGroup      String?
  email           String
  phone           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  admissionDate   DateTime  @default(now())
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Identity & personal — the fuller demographic/government-ID detail an Indian
  // school/college admission form actually collects
  religion       String?
  nationality    String? @default("Indian")
  motherTongue   String?
  aadhaarNumber  String?
  category       String? // caste/community category, e.g. General / OBC / SC / ST
  subCaste       String?
  alternatePhone String?

  // Contact — beyond the single residential address above
  district         String?
  permanentAddress String? // only filled in when different from the residential address
  landmark         String?

  // Prior academic record feeding this admission
  previousSchoolName    String?
  previousSchoolBoard   String?
  lastQualificationExam String? // e.g. "10th SSLC" / "12th HSC"
  qualifyingScore       String? // free text — marks/percentage/CGPA vary by board
  admissionQuota        String? // e.g. Management / Government / NRI
  scholarshipType       String?
  emisId                String? // state-assigned student UID, where applicable

  // Health & emergency
  medicalConditions     String?
  allergies             String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // Scholarship/refund disbursal
  bankAccountNumber String?
  bankIfscCode      String?
  bankName          String?

  // Service intent captured at admission — actual route/hostel-bed assignment happens
  // later via StudentTransportMapping / HostelBed, this is just "do they want it"
  transportRequired Boolean @default(false)
  hostelRequired    Boolean @default(false)

  departmentId String?
  courseId     String?
  semesterId   String?
  sectionId    String?

  // Relations
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution         Institution              @relation(fields: [institutionId], references: [id])
  department          Department?              @relation(fields: [departmentId], references: [id])
  course              Course?                  @relation(fields: [courseId], references: [id])
  section             Section?                 @relation(fields: [sectionId], references: [id])
  parents             ParentStudent[]
  attendanceRecords   AttendanceRecord[]
  leaveRequests       LeaveRequest[]
  submissions         AssignmentSubmission[]
  studentMarks        StudentMark[]
  feeAssignments      StudentFeeAssignment[]
  feePayments         FeePayment[]
  feeReceipts         FeeReceipt[]
  feeChallans         FeeChallan[]
  feeRefunds          FeeRefund[]
  bookIssues          BookIssue[]
  transport           StudentTransportMapping?
  hostelBed           HostelBed?
  hostelVisitorLogs   HostelVisitorLog[]
  certificateRequests CertificateRequest[]
  certificates        Certificate[]
  grievances          Grievance[]
  resume              StudentResume?
  eventRegistrations  EventRegistration[]
  clubMemberships     ClubMember[]
  achievements        StudentAchievement[]
  courseFeedback      CourseFeedback[]
  appointments        Appointment[]
  jobApplications     JobApplication[]
  parentMeetingNotes  ParentMeetingNote[]
  equipmentIssues     EquipmentIssue[]

  @@unique([institutionId, admissionNumber])
  @@unique([sectionId, rollNumber]) // roll numbers are assigned per-class; NULLs (no section/no roll yet) never collide
  @@index([institutionId, sectionId])
}

model Parent {
  id               String   @id @default(uuid())
  userId           String   @unique
  fatherName       String?
  fatherOccupation String?
  fatherPhone      String?
  fatherEmail      String?
  motherName       String?
  motherOccupation String?
  motherPhone      String?
  motherEmail      String?
  guardianName     String?
  guardianPhone    String?
  guardianRelation String? // how the guardian relates to the student, when a guardian is the primary contact instead of a parent
  annualIncome     String? // free text — family income bracket, used for scholarship eligibility
  address          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  students ParentStudent[]
}

model ParentStudent {
  id        String @id @default(uuid())
  parentId  String
  studentId String
  relation  String @default("FATHER")

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

// ------------------------------------------------------
// 5. STAFF
// ------------------------------------------------------

model Staff {
  id                       String    @id @default(uuid())
  userId                   String    @unique
  institutionId            String
  employeeCode             String
  firstName                String    @default("")
  lastName                 String    @default("")
  departmentId             String?
  designation              String
  staffType                String    @default("TEACHING") // TEACHING, NON_TEACHING
  qualification            String?
  experience               String?
  dob                      DateTime?
  bloodGroup               String?
  altPhone                 String?
  bankName                 String?
  bankAccountNumber        String?
  bankIfscCode             String?
  bankAccountName          String?
  panNumber                String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  emergencyContactAddress  String?
  joiningDate              DateTime  @default(now())
  status                   String    @default("ACTIVE")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution            Institution             @relation(fields: [institutionId], references: [id])
  department             Department?             @relation(fields: [departmentId], references: [id])
  subjectTeacherMappings SubjectTeacherMapping[]
  classTeacherOf         Section[]               @relation("SectionClassTeacher")
  attendanceSessions     AttendanceSession[]
  timetableEntries       TimetableEntry[]
  assignments            Assignment[]
  materials              StudyMaterial[]
  leaveRequests          LeaveRequest[]
  qualifications         StaffQualification[]
  experiences            StaffExperience[]
  salary                 StaffSalary?
  selfAttendance         StaffAttendance[]
  appointments           Appointment[]
  parentMeetingNotes     ParentMeetingNote[]
  sentSmsLogs            SmsLog[]
  equipmentIssues        EquipmentIssue[]

  @@unique([institutionId, employeeCode])
  @@index([institutionId, departmentId])
}

model StaffQualification {
  id              String   @id @default(uuid())
  staffId         String
  degree          String
  institutionName String
  yearOfPassing   Int
  grade           String?
  createdAt       DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model StaffExperience {
  id           String    @id @default(uuid())
  staffId      String
  organization String
  roleTitle    String
  fromDate     DateTime
  toDate       DateTime? // null = currently there / not applicable (prior employer)
  description  String?
  createdAt    DateTime  @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model StaffSalary {
  staffId         String   @id
  basicPay        Float    @default(0)
  hra             Float    @default(0)
  da              Float    @default(0)
  otherAllowances Float    @default(0)
  deductions      Float    @default(0)
  updatedAt       DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model StaffAttendance {
  id           String   @id @default(uuid())
  staffId      String
  date         DateTime @db.Date
  status       String   @default("PRESENT") // PRESENT, ABSENT, LATE, HALF_DAY, LEAVE
  checkInTime  String?
  checkOutTime String?
  createdAt    DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
}

// ------------------------------------------------------
// 6. ATTENDANCE & LEAVE
// ------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HALF_DAY
}

model AttendanceSession {
  id            String   @id @default(uuid())
  institutionId String
  sectionId     String
  subjectId     String?
  takenById     String
  date          DateTime
  periodNumber  Int?     @default(1)
  createdAt     DateTime @default(now())

  institution Institution        @relation(fields: [institutionId], references: [id])
  section     Section            @relation(fields: [sectionId], references: [id])
  subject     Subject?           @relation(fields: [subjectId], references: [id])
  takenBy     Staff              @relation(fields: [takenById], references: [id])
  records     AttendanceRecord[]

  @@unique([institutionId, sectionId, date, periodNumber])
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  remarks   String?

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id            String      @id @default(uuid())
  institutionId String
  studentId     String?
  staffId       String?
  type          String      @default("CASUAL") // CASUAL, EARNED, MEDICAL, DUTY
  startDate     DateTime
  endDate       DateTime
  reason        String
  status        LeaveStatus @default(PENDING)
  approvedBy    String?
  attachmentUrl String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])
  student     Student?    @relation(fields: [studentId], references: [id])
  staff       Staff?      @relation(fields: [staffId], references: [id])
}

// ------------------------------------------------------
// 7. TIMETABLE, ASSIGNMENTS & MATERIALS
// ------------------------------------------------------

model Timetable {
  id            String           @id @default(uuid())
  institutionId String
  sectionId     String
  entries       TimetableEntry[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])
  section     Section     @relation(fields: [sectionId], references: [id])

  @@unique([institutionId, sectionId])
}

model TimetableEntry {
  id          String  @id @default(uuid())
  timetableId String
  dayOfWeek   String // MONDAY, TUESDAY...
  period      Int
  startTime   String // "09:00"
  endTime     String // "10:00"
  subjectId   String?
  staffId     String?
  label       String? // used when there's no subject — e.g. "Assembly", "Lunch Break", "Games"
  roomNumber  String?

  timetable Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  subject   Subject?  @relation(fields: [subjectId], references: [id])
  staff     Staff?    @relation(fields: [staffId], references: [id])

  @@unique([timetableId, dayOfWeek, period])
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Assignment {
  id            String           @id @default(uuid())
  institutionId String
  staffId       String
  title         String
  description   String
  subjectName   String
  className     String
  dueDate       DateTime
  totalMarks    Float            @default(100)
  attachmentUrl String?
  status        AssignmentStatus @default(PUBLISHED)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  institution Institution            @relation(fields: [institutionId], references: [id])
  staff       Staff                  @relation(fields: [staffId], references: [id])
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id            String   @id @default(uuid())
  assignmentId  String
  studentId     String
  submittedAt   DateTime @default(now())
  fileUrl       String?
  content       String?
  marksObtained Float?
  feedback      String?
  status        String   @default("SUBMITTED") // SUBMITTED, REVIEWED, LATE

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model StudyMaterial {
  id            String   @id @default(uuid())
  institutionId String
  staffId       String
  subjectId     String?
  title         String
  description   String?
  fileType      String // PDF, PPT, DOC, VIDEO
  fileUrl       String
  fileSize      String?
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  staff       Staff       @relation(fields: [staffId], references: [id])
  subject     Subject?    @relation(fields: [subjectId], references: [id])
}

// ------------------------------------------------------
// 8. QUESTION BANK, EXAMS & MARKS
// ------------------------------------------------------

enum QuestionType {
  MCQ
  MULTIPLE_CORRECT
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
  LONG_ANSWER
}

model QuestionBank {
  id            String       @id @default(uuid())
  institutionId String
  subjectId     String
  chapter       String?
  topic         String?
  type          QuestionType @default(MCQ)
  difficulty    String       @default("MEDIUM") // EASY, MEDIUM, HARD
  questionText  String
  explanation   String?
  marks         Float        @default(1)
  options       Json? // Array of options
  correctAnswer String
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])
  subject     Subject     @relation(fields: [subjectId], references: [id])
}

model Exam {
  id             String   @id @default(uuid())
  institutionId  String
  academicYearId String
  name           String // e.g. "Mid Term Examination 2026"
  examType       String // MID_TERM, FINAL, UNIT_TEST
  startDate      DateTime
  endDate        DateTime
  status         String   @default("SCHEDULED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution  Institution    @relation(fields: [institutionId], references: [id])
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])
  schedules    ExamSchedule[]
}

model ExamSchedule {
  id          String    @id @default(uuid())
  examId      String
  subjectId   String
  examDate    DateTime
  startTime   String
  endTime     String
  maxMarks    Float     @default(100)
  passMarks   Float     @default(35)
  roomNumber  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  exam         Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject      Subject       @relation(fields: [subjectId], references: [id])
  studentMarks StudentMark[]
}

model StudentMark {
  id             String   @id @default(uuid())
  examScheduleId String
  studentId      String
  marksObtained  Float
  grade          String?
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  examSchedule ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examScheduleId, studentId])
}

// ------------------------------------------------------
// 9. FEES & PAYMENTS
// ------------------------------------------------------

enum FeeCategoryType {
  TUITION_FEE
  EXAM_FEE
  LIBRARY_FEE
  TRANSPORT_FEE
  HOSTEL_FEE
  LAB_FEE
  ADMISSION_FEE
  DEVELOPMENT_FEE
  OTHER_FEE
}

enum FeeStructureStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Layer 1 — institution-defined fee categories (e.g. Academic, Administrative, Facilities).
/// Unlimited, custom per institution — never hardcoded in frontend code.
model FeeCategory {
  id            String   @id @default(uuid())
  institutionId String
  name          String
  code          String
  description   String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  feeHeads    FeeHead[]

  @@unique([institutionId, code])
}

/// Layer 1 — institution-defined fee heads (Tuition, Transport, Hostel, ...). Unlimited,
/// custom per institution — this is the metadata that replaces hardcoded fee-type columns.
model FeeHead {
  id                String   @id @default(uuid())
  institutionId     String
  categoryId        String?
  name              String
  code              String
  description       String?
  mandatory         Boolean  @default(true)
  active            Boolean  @default(true)
  taxApplicable     Boolean  @default(false)
  lateFeeApplicable Boolean  @default(false)
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  institution    Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  category       FeeCategory?       @relation(fields: [categoryId], references: [id])
  structureItems FeeStructureItem[]
  studentItems   StudentFeeItem[]

  @@unique([institutionId, code])
}

model FeeStructure {
  id                String             @id @default(uuid())
  institutionId     String
  academicYearId    String
  courseId          String?
  sectionId         String?
  name              String // e.g. "Annual Fee B.Tech 2026"
  category          FeeCategoryType    @default(TUITION_FEE) // deprecated single-category tag — kept for legacy rows; FeeStructureItem→FeeHead is now the source of truth
  totalAmount       Float // cached sum of item amounts once published; kept in sync by the builder
  dueDate           DateTime
  lateFeePerDay     Float              @default(0)
  frequency         String             @default("ANNUAL") // ONE_TIME, MONTHLY, QUARTERLY, HALF_YEARLY, ANNUAL, SEMESTER, INSTALLMENT, CUSTOM
  status            FeeStructureStatus @default(DRAFT)
  version           Int                @default(1)
  parentStructureId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  institution     Institution            @relation(fields: [institutionId], references: [id])
  academicYear    AcademicYear           @relation(fields: [academicYearId], references: [id])
  course          Course?                @relation(fields: [courseId], references: [id])
  parentStructure FeeStructure?          @relation("StructureVersions", fields: [parentStructureId], references: [id])
  versions        FeeStructure[]         @relation("StructureVersions")
  items           FeeStructureItem[]
  assignments     StudentFeeAssignment[]

  @@index([institutionId, status])
}

/// One fee-head line item within a structure — e.g. "Tuition Fee: ₹30,000 Annual" — the
/// piece the old single-totalAmount FeeStructure was missing.
model FeeStructureItem {
  id             String    @id @default(uuid())
  feeStructureId String
  feeHeadId      String
  amount         Float
  frequency      String    @default("ANNUAL")
  dueDate        DateTime?
  mandatory      Boolean   @default(true)
  sortOrder      Int       @default(0)

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeHead      FeeHead      @relation(fields: [feeHeadId], references: [id])

  @@unique([feeStructureId, feeHeadId])
}

model StudentFeeAssignment {
  id               String   @id @default(uuid())
  feeStructureId   String
  studentId        String
  structureVersion Int      @default(1) // snapshot of FeeStructure.version at assignment time
  totalAmount      Float
  discountAmount   Float    @default(0)
  scholarshipName  String? // e.g. "First Generation Graduate (FGG)"
  scholarshipRef   String? // Govt sanction / reference number
  paidAmount       Float    @default(0)
  dueAmount        Float
  status           String   @default("PENDING") // PENDING, PARTIAL, PAID
  createdAt        DateTime @default(now())

  feeStructure FeeStructure     @relation(fields: [feeStructureId], references: [id])
  student      Student          @relation(fields: [studentId], references: [id])
  payments     FeePayment[]
  installments FeeInstallment[]
  items        StudentFeeItem[]

  @@unique([feeStructureId, studentId])
}

/// The per-student, per-fee-head breakdown — snapshotted from FeeStructureItem at
/// assignment time, so it stays historically accurate even if the fee head is later renamed
/// or the structure is edited. This is what the Student Fee Page (section 9) renders.
model StudentFeeItem {
  id                     String   @id @default(uuid())
  studentFeeAssignmentId String
  feeHeadId              String
  feeHeadName            String // snapshot of FeeHead.name at assignment time
  amount                 Float
  discountAmount         Float    @default(0)
  paidAmount             Float    @default(0)
  dueAmount              Float
  status                 String   @default("PENDING") // PENDING, PARTIAL, PAID
  createdAt              DateTime @default(now())

  studentFeeAssignment StudentFeeAssignment @relation(fields: [studentFeeAssignmentId], references: [id], onDelete: Cascade)
  feeHead              FeeHead              @relation(fields: [feeHeadId], references: [id])
  allocations          PaymentAllocation[]

  @@index([studentFeeAssignmentId])
}

/// Splits one FeePayment across the multiple fee-head items it actually paid off — never a
/// single unstructured payment for a multi-head transaction.
model PaymentAllocation {
  id               String @id @default(uuid())
  feePaymentId     String
  studentFeeItemId String
  amount           Float

  feePayment     FeePayment     @relation(fields: [feePaymentId], references: [id], onDelete: Cascade)
  studentFeeItem StudentFeeItem @relation(fields: [studentFeeItemId], references: [id])

  @@index([feePaymentId])
  @@index([studentFeeItemId])
}

model FeeInstallment {
  id                     String   @id @default(uuid())
  studentFeeAssignmentId String
  installmentNumber      Int
  amount                 Float
  dueDate                DateTime
  paidAmount             Float    @default(0)
  status                 String   @default("PENDING") // PENDING, PARTIAL, PAID
  createdAt              DateTime @default(now())

  studentFeeAssignment StudentFeeAssignment @relation(fields: [studentFeeAssignmentId], references: [id], onDelete: Cascade)
  payments             FeePayment[]

  @@unique([studentFeeAssignmentId, installmentNumber])
}

enum PaymentMode {
  CASH
  CHEQUE
  DD
  BANK_TRANSFER
  UPI_MANUAL
  RAZORPAY
  ONLINE_CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  SUCCESS
  FAILED
  REJECTED
  REFUNDED
  CANCELLED
}

model FeePayment {
  id                     String        @id @default(uuid())
  institutionId          String
  studentId              String
  studentFeeAssignmentId String
  installmentId          String?
  idempotencyKey         String?       @unique // dedupes a retried/duplicate gateway webhook or double-submit
  amountPaid             Float
  paymentMode            PaymentMode   @default(CASH)
  paymentStatus          PaymentStatus @default(SUCCESS)
  transactionReference   String?
  bankName               String?
  chequeNumber           String?
  chequeDate             DateTime?
  receivedBy             String?
  remarks                String?
  paidAt                 DateTime      @default(now())

  institution          Institution          @relation(fields: [institutionId], references: [id])
  student              Student              @relation(fields: [studentId], references: [id])
  studentFeeAssignment StudentFeeAssignment @relation(fields: [studentFeeAssignmentId], references: [id])
  installment          FeeInstallment?      @relation(fields: [installmentId], references: [id])
  receipt              FeeReceipt?
  allocations          PaymentAllocation[]

  @@index([institutionId, studentId])
}

model FeeReceipt {
  id            String    @id @default(uuid())
  receiptNumber String    @unique
  institutionId String
  studentId     String
  paymentId     String    @unique
  amount        Float
  printCount    Int       @default(0) // 0 = never printed; incremented on every print/reprint
  lastPrintedAt DateTime?
  issuedAt      DateTime  @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])
  payment     FeePayment  @relation(fields: [paymentId], references: [id])
}

model FeeChallan {
  id            String   @id @default(uuid())
  challanNumber String   @unique
  institutionId String
  studentId     String
  amount        Float
  dueDate       DateTime
  bankName      String   @default("State Bank of India")
  status        String   @default("GENERATED")
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])
}

model FeeRefund {
  id            String    @id @default(uuid())
  institutionId String
  studentId     String
  reason        String
  amount        Float
  bankAccount   String?
  status        String    @default("PENDING") // PENDING, PROCESSED, REJECTED
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])
}

// ------------------------------------------------------
// 10. CAMPUS SERVICES (LIBRARY, TRANSPORT, HOSTEL)
// ------------------------------------------------------

model Book {
  id              String   @id @default(uuid())
  institutionId   String
  title           String
  author          String
  isbn            String?
  category        String?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  createdAt       DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  issues      BookIssue[]
}

model BookIssue {
  id         String    @id @default(uuid())
  bookId     String
  studentId  String
  issuedAt   DateTime  @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  fineAmount Float     @default(0)
  finePaid   Boolean   @default(false)
  status     String    @default("ISSUED") // ISSUED, RETURNED

  book    Book    @relation(fields: [bookId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
}

model Vehicle {
  id                  String    @id @default(uuid())
  institutionId       String
  vehicleNumber       String
  vehicleType         String    @default("BUS") // BUS, VAN, MINI_BUS
  capacity            Int       @default(40)
  driverName          String?
  driverPhone         String?
  driverLicenseNumber String?
  licenseExpiryDate   DateTime?
  fcExpiryDate        DateTime?
  insuranceExpiryDate DateTime?
  gpsEnabled          Boolean   @default(false)
  createdAt           DateTime  @default(now())

  institution Institution      @relation(fields: [institutionId], references: [id])
  routes      TransportRoute[]
  trips       VehicleTrip[]
}

model VehicleTrip {
  id          String    @id @default(uuid())
  vehicleId   String
  tripDate    DateTime  @db.Date
  session     String // MORNING, EVENING
  status      String    @default("PENDING") // PENDING, COMPLETED
  completedAt DateTime?
  remarks     String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, tripDate, session])
}

model TransportRoute {
  id            String   @id @default(uuid())
  institutionId String
  vehicleId     String?
  routeName     String
  startPoint    String
  endPoint      String
  monthlyFare   Float
  createdAt     DateTime @default(now())

  institution Institution               @relation(fields: [institutionId], references: [id])
  vehicle     Vehicle?                  @relation(fields: [vehicleId], references: [id])
  mappings    StudentTransportMapping[]
}

model StudentTransportMapping {
  id          String   @id @default(uuid())
  studentId   String   @unique
  routeId     String
  pickupPoint String
  createdAt   DateTime @default(now())

  student Student        @relation(fields: [studentId], references: [id])
  route   TransportRoute @relation(fields: [routeId], references: [id])
}

model Hostel {
  id            String   @id @default(uuid())
  institutionId String
  name          String
  type          String   @default("BOYS") // BOYS, GIRLS
  warden        String?
  messType      String? // e.g. "Veg Only", "Veg & Non-Veg"
  capacity      Int      @default(100)
  createdAt     DateTime @default(now())

  institution Institution        @relation(fields: [institutionId], references: [id])
  beds        HostelBed[]
  visitors    HostelVisitorLog[]
}

model HostelBed {
  id         String  @id @default(uuid())
  hostelId   String
  roomNumber String
  bedNumber  String
  studentId  String? @unique
  isOccupied Boolean @default(false)
  monthlyFee Float   @default(5000)

  hostel     Hostel             @relation(fields: [hostelId], references: [id])
  student    Student?           @relation(fields: [studentId], references: [id])
  attendance HostelAttendance[]

  @@unique([hostelId, roomNumber, bedNumber])
}

model HostelAttendance {
  id          String   @id @default(uuid())
  hostelBedId String
  date        DateTime @db.Date
  status      String   @default("PRESENT") // PRESENT, ABSENT, LEAVE
  remarks     String?
  markedAt    DateTime @default(now())

  hostelBed HostelBed @relation(fields: [hostelBedId], references: [id], onDelete: Cascade)

  @@unique([hostelBedId, date])
}

model HostelVisitorLog {
  id           String    @id @default(uuid())
  hostelId     String
  studentId    String
  visitorName  String
  relationship String?
  gatePassNo   String    @unique
  checkInAt    DateTime  @default(now())
  checkOutAt   DateTime?

  hostel  Hostel  @relation(fields: [hostelId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
}

// ------------------------------------------------------
// 11. CERTIFICATES, DOCUMENTS, MESSAGES & GRIEVANCES
// ------------------------------------------------------

model CertificateRequest {
  id            String    @id @default(uuid())
  studentId     String
  type          String // BONAFIDE, TRANSFER, CONDUCT, COURSE_COMPLETION
  reason        String?
  status        String    @default("PENDING") // PENDING, APPROVED, READY, REJECTED
  certificateNo String?
  issuedAt      DateTime?
  createdAt     DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id])
}

model Certificate {
  id            String   @id @default(uuid())
  institutionId String
  studentId     String?
  templateId    String? // which CertificateTemplate rendered this — null for pre-engine legacy rows
  type          String   @default("BONAFIDE") // BONAFIDE, TC, CONDUCT, COMPLETION, FEEPAID
  certificateNo String   @unique
  title         String
  issuedToName  String
  details       Json? // ad-hoc per-type fields (dateOfLeaving, reasonForLeaving, conduct, etc.)
  renderedBody  String? // the actual wording snapshot at issuance time — stays fixed even if the template is edited later
  pdfUrl        String?
  createdAt     DateTime @default(now())

  institution Institution          @relation(fields: [institutionId], references: [id])
  student     Student?             @relation(fields: [studentId], references: [id])
  template    CertificateTemplate? @relation(fields: [templateId], references: [id])
}

model Announcement {
  id              String   @id @default(uuid())
  institutionId   String? // null = platform-wide broadcast authored by Super Admin
  authorId        String?
  title           String
  content         String
  targetRole      String   @default("ALL") // ALL, STAFF, STUDENTS, PARENTS
  targetCourseId  String? // null = every course
  targetSectionId String? // null = every section
  priority        String   @default("NORMAL") // NORMAL, HIGH, URGENT
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution   Institution? @relation(fields: [institutionId], references: [id])
  author        User?        @relation(fields: [authorId], references: [id])
  targetCourse  Course?      @relation(fields: [targetCourseId], references: [id])
  targetSection Section?     @relation(fields: [targetSectionId], references: [id])

  @@index([institutionId, createdAt])
}

model Notification {
  id            String   @id @default(uuid())
  institutionId String? // null for platform-level notifications (Super Admin) not tied to any one tenant
  userId        String
  title         String
  message       String
  type          String? // e.g. ADMISSION, HOMEWORK, ATTENDANCE, FEE, SUPPORT_TICKET, SMS_CREDIT, INSTITUTION — lets the bell icon vary by category
  link          String? // optional in-app path to navigate to when the notification is clicked
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id])
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Event {
  id            String   @id @default(uuid())
  institutionId String
  title         String
  description   String?
  eventDate     DateTime
  venue         String?
  createdAt     DateTime @default(now())

  institution   Institution         @relation(fields: [institutionId], references: [id])
  registrations EventRegistration[]
}

model EventRegistration {
  id           String    @id @default(uuid())
  eventId      String
  studentId    String
  registeredAt DateTime  @default(now())
  attended     Boolean   @default(false)
  attendedAt   DateTime?

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
}

model Club {
  id            String   @id @default(uuid())
  institutionId String
  name          String
  description   String?
  inchargeName  String?
  createdAt     DateTime @default(now())

  institution Institution  @relation(fields: [institutionId], references: [id])
  members     ClubMember[]
}

model ClubMember {
  id        String   @id @default(uuid())
  clubId    String
  studentId String
  joinedAt  DateTime @default(now())

  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([clubId, studentId])
}

model Grievance {
  id            String   @id @default(uuid())
  institutionId String
  studentId     String
  subject       String
  description   String
  status        String   @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, RESOLVED
  resolution    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())

  sender User @relation("SentMessages", fields: [senderId], references: [id])
}

model StudentResume {
  id        String   @id @default(uuid())
  studentId String   @unique
  summary   String?
  skills    Json? // Array of skills
  projects  Json? // Array of projects
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
}

model StudentAchievement {
  id            String   @id @default(uuid())
  institutionId String
  studentId     String
  title         String
  description   String?
  category      String   @default("OTHER") // ACADEMIC, SPORTS, CULTURAL, TECHNICAL, OTHER
  awardedDate   DateTime
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// Anonymous end-of-semester faculty/course feedback. studentId is kept (never null) only
// to enforce "one submission per student per subject" via the unique constraint below —
// no controller ever selects or returns it, so staff/admin only ever see aggregates.
model CourseFeedback {
  id        String   @id @default(uuid())
  studentId String
  subjectId String
  rating    Int // 1-5
  comments  String?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
}

model Appointment {
  id            String   @id @default(uuid())
  institutionId String
  studentId     String
  staffId       String
  slotDate      DateTime
  slotTime      String
  purpose       String?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff       Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

// Parent-Teacher Meeting minutes logged by a staff member after a real conversation with a
// student's parent/guardian.
model ParentMeetingNote {
  id              String   @id @default(uuid())
  institutionId   String
  studentId       String
  staffId         String
  parentName      String?
  discussionNotes String
  meetingDate     DateTime @default(now())
  createdAt       DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff       Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([studentId])
}

// Placement Cell — internships & job postings managed by the Institute Admin, applied to
// by students. `type` distinguishes an Internship listing from a full Placement listing.
model JobPosting {
  id                  String    @id @default(uuid())
  institutionId       String
  title               String
  company             String
  type                String    @default("INTERNSHIP") // INTERNSHIP, PLACEMENT
  location            String?
  compensation        String? // free-text stipend/salary, e.g. "₹18,000 / month"
  description         String?
  eligibility         String?
  applicationDeadline DateTime?
  status              String    @default("OPEN") // OPEN, CLOSED
  createdAt           DateTime  @default(now())

  institution  Institution      @relation(fields: [institutionId], references: [id])
  applications JobApplication[]
}

model JobApplication {
  id           String   @id @default(uuid())
  jobPostingId String
  studentId    String
  status       String   @default("APPLIED") // APPLIED, SHORTLISTED, SELECTED, REJECTED
  appliedAt    DateTime @default(now())

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([jobPostingId, studentId])
}

// Real forgot-password OTP flow, shared by all 4 portals' login pages (User is the one
// table every role authenticates against, so this needs no per-portal duplication).
model PasswordResetOtp {
  id        String   @id @default(uuid())
  userId    String
  otpCode   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, otpCode])
}

// ------------------------------------------------------
// 12. AUDIT LOGS & PLATFORM SUBSCRIPTIONS
// ------------------------------------------------------

model InstitutionSettings {
  institutionId             String   @id
  smtpHost                  String?
  smtpPort                  String?
  smtpFromEmail             String?
  smsProvider               String?
  smsSenderId               String?
  smsDltEntityId            String?
  staffAttendanceSmsEnabled Boolean  @default(true) // lets the Institute Admin turn off the auto-SMS-to-parent feature staff trigger by marking a student absent
  idCardOrientation         String   @default("VERTICAL") // VERTICAL | HORIZONTAL — the institution's chosen ID card layout, applied everywhere a student/staff ID card renders
  idCardTemplate            String   @default("CLASSIC") // CLASSIC | MODERN | MINIMAL — the institution's chosen visual style
  paymentGatewayProvider    String?
  paymentKeyId              String? // public key/merchant id only — secrets stay server-side (.env), never stored here
  updatedAt                 DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])
}

model AuditLog {
  id            String   @id @default(uuid())
  institutionId String?
  userId        String?
  action        String
  module        String
  entity        String?
  entityId      String?
  oldValues     Json?
  newValues     Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])

  @@index([institutionId, createdAt])
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String // BASIC, STANDARD, ENTERPRISE
  priceMonthly  Float
  priceYearly   Float
  maxStudents   Int            @default(500)
  maxStaff      Int            @default(50)
  sacCode       String         @default("998313") // GST Services Accounting Code for SaaS subscriptions
  features      Json?
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id            String   @id @default(uuid())
  institutionId String
  planId        String
  startDate     DateTime
  endDate       DateTime
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())

  institution Institution      @relation(fields: [institutionId], references: [id])
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
  invoices    Invoice[]
}

model Invoice {
  id               String    @id @default(uuid())
  invoiceNumber    String    @unique
  institutionId    String
  subscriptionId   String?
  planName         String?
  billingPeriod    String? // e.g. "Enterprise Subscription (1 Year)"
  baseAmount       Float
  gstRate          Float     @default(18)
  sacCode          String    @default("998313")
  institutionGstin String? // snapshot of the institution's GSTIN at invoice time
  placeOfSupply    String? // institution's state at invoice time, drives CGST+SGST vs IGST
  cgst             Float     @default(0)
  sgst             Float     @default(0)
  igst             Float     @default(0)
  totalAmount      Float
  paymentMode      String?
  status           String    @default("PENDING") // PAID, PENDING, OVERDUE, CANCELLED
  dueDate          DateTime
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  institution  Institution   @relation(fields: [institutionId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([institutionId])
  @@index([status])
}

// ------------------------------------------------------
// 13. SUPER ADMIN PLATFORM OPERATIONS
// (Role Permission overrides, Support Desk, Settings, AI/SMS usage logging)
// ------------------------------------------------------

model RolePermissionOverride {
  id          String   @id @default(uuid())
  role        String   @unique
  permissions Json // array of permission keys, overrides the static default matrix for this role
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id            String         @id @default(uuid())
  ticketNumber  String         @unique
  institutionId String?
  subject       String
  description   String?
  category      String?
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  raisedByEmail String?
  assignedTo    String?
  resolvedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  institution Institution? @relation(fields: [institutionId], references: [id])

  @@index([institutionId])
  @@index([status])
}

model PlatformSetting {
  id              String  @id @default("global")
  appName         String  @default("SCOMS Platform")
  timezone        String  @default("Asia/Kolkata")
  currency        String  @default("INR (₹)")
  localization    String  @default("English")
  maintenanceMode Boolean @default(false)

  // Platform's own GST billing identity — the "supplier" side of every invoice generated
  companyName    String @default("SCOMS Educational Software Solutions Pvt. Ltd.")
  companyGstin   String @default("33AAAAA0000A1Z5")
  companyState   String @default("Tamil Nadu") // determines CGST+SGST (intra-state) vs IGST (inter-state) per invoice
  companyAddress String @default("100, Tech Park Road, Guindy, Chennai, Tamil Nadu - 600032")

  updatedBy String?
  updatedAt DateTime @updatedAt
}

model AiUsageLog {
  id               String   @id @default(uuid())
  institutionId    String?
  userId           String?
  role             String?
  module           String // e.g. AI_ASSISTANT, QUESTION_GENERATOR
  provider         String   @default("Internal Mock Provider")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUSD          Float    @default(0)
  createdAt        DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id])

  @@index([institutionId, createdAt])
  @@index([module])
}

model SmsLog {
  id             String   @id @default(uuid())
  institutionId  String?
  sentByStaffId  String? // set when a staff member (not the system) triggered this SMS
  recipientPhone String
  message        String
  provider       String   @default("Simulated Gateway")
  purpose        String? // e.g. ATTENDANCE_ALERT, WELCOME_CREDENTIALS, FEE_REMINDER, STAFF_BROADCAST
  status         String   @default("SIMULATED") // SENT, FAILED, SIMULATED
  createdAt      DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id])
  sentByStaff Staff?       @relation(fields: [sentByStaffId], references: [id])

  @@index([institutionId, createdAt])
  @@index([status])
  @@index([sentByStaffId])
}

