// ------------------------------------------------------
// 26. PHOTO GALLERY
// ------------------------------------------------------

model GalleryAlbum {
  id            String   @id @default(uuid())
  institutionId String
  title         String
  description   String?
  category      String   @default("GENERAL") // EVENTS, SPORTS, ACADEMICS, CULTURAL, GENERAL
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy   Staff?         @relation(fields: [createdById], references: [id])
  photos      GalleryPhoto[]

  @@index([institutionId, category])
}

/// A real document attached to a student's record — birth certificate, transfer
/// certificate from a previous school, ID proof, etc. Stored as a base64 data URI, same
/// convention as GalleryPhoto.imageData/Institution.logo (no external file storage is
/// wired up in this codebase yet — STORAGE_* env vars are placeholders, see .env).
enum StudentDocumentType {
  BIRTH_CERTIFICATE
  TRANSFER_CERTIFICATE
  MARKSHEET
  ID_PROOF
  ADDRESS_PROOF
  MEDICAL_RECORD
  OTHER
}

model StudentDocument {
  id            String              @id @default(uuid())
  institutionId String
  studentId     String
  documentType  StudentDocumentType @default(OTHER)
  title         String
  fileData      String // base64 data URI
  fileName      String?
  mimeType      String?
  uploadedById  String? // Staff.id or the Institute Admin's User.id — no FK, either can upload
  uploadedAt    DateTime            @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([institutionId, studentId])
}

model GalleryPhoto {
  id           String   @id @default(uuid())
  albumId      String
  imageData    String // base64 data URI — same convention as Institution.logo, no external storage needed
  caption      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  album      GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  uploadedBy Staff?       @relation(fields: [uploadedById], references: [id])

  @@index([albumId])
}

// ------------------------------------------------------
// 27. GRADING SYSTEM
// ------------------------------------------------------

/// Institution-configurable letter-grade / grade-point scale. Drives both the letter
/// grade shown against each subject mark and real SGPA/CGPA computation on marksheets —
/// replacing what used to be a hardcoded, non-editable scale.
model GradeScale {
  id            String   @id @default(uuid())
  institutionId String
  grade         String // e.g. O, A+, A, B+, B, F
  minPercentage Float
  maxPercentage Float
  gradePoint    Float // on a 10-point scale
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, grade])
  @@index([institutionId])
}

// ------------------------------------------------------
// 28. MESSAGE TEMPLATES (SMS / Email / WhatsApp)
// ------------------------------------------------------

enum MessageChannel {
  SMS
  EMAIL
  WHATSAPP
}

/// A reusable message template for bulk broadcast. `institutionId` null = a platform
/// default (isSystem: true, seeded once, visible to every institution, never editable
/// by an Institute Admin); a real institutionId = that institution's own custom
/// template, fully editable/deletable by them. `body` may contain {{name}} which the
/// broadcast sender substitutes with each real recipient's name at send time.
model MessageTemplate {
  id            String         @id @default(uuid())
  institutionId String?
  channel       MessageChannel
  category      String // OTP_LOGIN, WELCOME_CREDENTIALS, FEE_DUE, ATTENDANCE_ABSENT, EXAM_SCHEDULE, ...
  title         String
  subject       String? // EMAIL only
  body          String
  isSystem      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, channel])
  @@index([channel, category])
}

// ------------------------------------------------------
// 29. PRE-ADMISSION (public application form API)
// ------------------------------------------------------

enum PreAdmissionStatus {
  NEW
  UNDER_REVIEW
  SHORTLISTED
  ENROLLED
  REJECTED
  CONVERTED
}

/// One submission from an institution's own external website admission-application
/// form, posted to the public /pre-admission/submit endpoint using that institution's
/// preAdmissionApiKey — or logged manually by front-office staff for a walk-in/phone
/// applicant. rawPayload keeps the full original submission (including any custom
/// fields the institution's form collects that don't map to a named column below), so
/// nothing the applicant submitted is ever silently dropped.
///
/// Real workflow, matching how school/college front offices actually run this:
/// NEW → (review) → SHORTLISTED → ENROLLED (accepted, applicationNumber/receiptNumber
/// issued) → CONVERTED (an "Admit" action turns it into a real Student record) — or
/// REJECTED at any point before that.
model PreAdmissionApplication {
  id                 String             @id @default(uuid())
  institutionId      String
  applicationNumber  String // e.g. "DPIS/PADM/2026/00001" — auto-generated, always set, this institution's own tracking number
  referenceNumber    String? // optional external reference the institution's own website/CRM may already use
  receiptNumber      String? // set once "Generate Receipt" is used — an application/registration fee receipt
  studentFirstName   String
  studentLastName    String?
  dob                DateTime?
  gender             String?
  classAppliedFor    String? // school-style ("Class 5")
  courseApplied      String? // college-style ("B.Tech CSE") — a form only fills whichever applies to that institution
  academicYear       String?
  parentName         String?
  parentPhone        String
  parentEmail        String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  previousSchool     String?
  previousClass      String?
  source             String             @default("WEBSITE") // WEBSITE, API, MANUAL
  submittedFromIp    String?
  rawPayload         Json? // the full submitted body, kept as-is for audit/debugging
  customFields       Json? // only the values matching APPROVED AdmissionCustomField keys at submission time — this is what actually carries through to the Student on Admit
  // Application fee — only meaningful when the institution has set Institution.preAdmissionFeeAmount;
  // feeAmount is snapshotted at submission time so a later fee-amount change never rewrites history.
  feeAmount          Float?
  feePaid            Boolean            @default(false)
  feePaymentId       String? // the real Razorpay payment id once verified (see shared/utils/paymentGateway)
  feePaidAt          DateTime?
  status             PreAdmissionStatus @default(NEW)
  enrolledAt         DateTime? // when the applicant was accepted/enrolled (the "Enroll" action)
  reviewNotes        String?
  reviewedById       String?
  convertedStudentId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  reviewedBy  Staff?      @relation(fields: [reviewedById], references: [id])

  @@unique([institutionId, applicationNumber])
  @@index([institutionId, status])
}

/// One institution-defined extra field on top of a standard form. An institution can
/// draft/edit/reorder these freely, but nothing renders on any real form until
/// SuperAdmin flips it to APPROVED — see the status lifecycle below. Originally built
/// for the admission form only; entityType generalizes the exact same lifecycle to any
/// other form that opts in (Staff Profile today, more as they're added) without a new
/// table or a new approval workflow per module.
enum CustomFieldStatus {
  DRAFT // being edited by the Institute Admin, not yet submitted
  PENDING_APPROVAL // submitted, waiting on SuperAdmin
  APPROVED // live — renders on the real form
  REJECTED // SuperAdmin declined; rejectionReason explains why
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  EMAIL
  PHONE
  TEXTAREA
  SELECT
  CHECKBOX
}

/// Which real form a custom field applies to — each entity type stores its approved
/// field values in that entity's own `customFields` Json column (Student.customFields
/// for ADMISSION, Staff.customFields for STAFF_PROFILE, StudentTransportMapping.customFields
/// for TRANSPORT_ENROLLMENT, HostelBed.customFields for HOSTEL_ALLOCATION,
/// StudentFeeAssignment.customFields for FEE_ASSIGNMENT, LibraryMember.customFields for
/// LIBRARY_MEMBERSHIP).
enum CustomFieldEntityType {
  ADMISSION
  STAFF_PROFILE
  TRANSPORT_ENROLLMENT
  HOSTEL_ALLOCATION
  FEE_ASSIGNMENT
  LIBRARY_MEMBERSHIP
}

model AdmissionCustomField {
  id                  String                @id @default(uuid())
  institutionId       String
  entityType          CustomFieldEntityType @default(ADMISSION)
  fieldKey            String // machine key, e.g. "blood_donor_consent" — stored as the key inside that entity type's own customFields column
  label               String
  fieldType           CustomFieldType       @default(TEXT)
  section             String                @default("Additional Information")
  options             Json? // string[] of choices, only meaningful for fieldType SELECT
  required            Boolean               @default(false)
  order               Int                   @default(0)
  helpText            String? // small explanatory text shown under the field label
  hidden              Boolean               @default(false) // captured but not rendered — e.g. a value set programmatically rather than typed by the user
  visibilityCondition Json? // { dependsOnFieldKey, operator: 'equals'|'not_equals', value } — only render this field when the referenced field's live value matches; null = always visible (subject to `hidden` above)
  status              CustomFieldStatus     @default(DRAFT)
  submittedAt         DateTime? // when it last moved DRAFT -> PENDING_APPROVAL
  reviewedById        String? // SuperAdmin User.id who approved/rejected it — no FK, SuperAdmin users live outside institution scope
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, entityType, fieldKey])
  @@index([institutionId, entityType, status])
}

/// A self-service picklist an institution manages itself — no SuperAdmin approval,
/// unlike AdmissionCustomField above, because these are just labels on existing fixed
/// fields (LeaveRequest.type, DisciplineRecord.category, Exam.examType are already free
/// strings), never new data-collection surfaces. Institute Admin can add/rename/retire
/// entries any time; retiring one (isActive: false) keeps historical records readable
/// without offering it on new entries.
enum InstitutionListType {
  LEAVE_TYPE
  DISCIPLINE_CATEGORY
  EXAM_TYPE
}

model InstitutionCustomList {
  id            String              @id @default(uuid())
  institutionId String
  listType      InstitutionListType
  code          String // the actual value stored on the record, e.g. "CASUAL"
  label         String // display label, e.g. "Casual Leave (CL)"
  sortOrder     Int                 @default(0)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, listType, code])
  @@index([institutionId, listType])
}
