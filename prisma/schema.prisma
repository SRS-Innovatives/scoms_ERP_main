// SCOMS - School & College Management System Database Schema
// Prisma Schema for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// 1. INSTITUTIONS & SAAS TENANCY
// ------------------------------------------------------

enum InstitutionType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  POLYTECHNIC
}

enum InstitutionStatus {
  ACTIVE
  PENDING
  SUSPENDED
  EXPIRED
}

model Institution {
  id                 String            @id @default(uuid())
  code               String            @unique
  name               String
  type               InstitutionType   @default(SCHOOL)
  registrationNumber String?
  affiliation        String?
  board              String?
  university         String?
  email              String
  phone              String
  website            String?
  logo               String?
  address            String
  city               String
  district           String?
  state              String
  pincode            String
  country            String            @default("India")
  principalName      String?
  establishedYear    Int?
  status             InstitutionStatus @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  // Relations
  users                  User[]
  academicYears          AcademicYear[]
  departments            Department[]
  courses                Course[]
  students               Student[]
  staff                  Staff[]
  attendanceSessions     AttendanceSession[]
  leaveRequests          LeaveRequest[]
  timetables             Timetable[]
  assignments            Assignment[]
  materials              StudyMaterial[]
  questionBanks          QuestionBank[]
  exams                  Exam[]
  feeStructures          FeeStructure[]
  feePayments            FeePayment[]
  feeReceipts            FeeReceipt[]
  feeChallans            FeeChallan[]
  books                  Book[]
  vehicles               Vehicle[]
  routes                 TransportRoute[]
  hostels                Hostel[]
  certificates           Certificate[]
  announcements          Announcement[]
  notifications          Notification[]
  events                 Event[]
  clubs                  Club[]
  grievances             Grievance[]
  auditLogs              AuditLog[]
  subscriptions          Subscription[]
  invoices               Invoice[]

  @@index([code])
  @@index([status])
}

// ------------------------------------------------------
// 2. USERS, ROLES & AUTHENTICATION
// ------------------------------------------------------

enum RoleType {
  SUPER_ADMIN
  PLATFORM_ADMIN
  INSTITUTE_ADMIN
  PRINCIPAL
  VICE_PRINCIPAL
  HOD
  TEACHER
  STAFF
  ACCOUNTANT
  LIBRARIAN
  TRANSPORT_MANAGER
  HOSTEL_WARDEN
  EXAM_ADMIN
  PLACEMENT_OFFICER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id             String        @id @default(uuid())
  institutionId  String?
  email          String?
  mobile         String?
  admissionNumber String?
  employeeCode   String?
  password       String
  role           RoleType      @default(STUDENT)
  status         UserStatus    @default(ACTIVE)
  avatar         String?
  lastLoginAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // Relations
  institution    Institution?  @relation(fields: [institutionId], references: [id])
  student        Student?
  staff          Staff?
  parent         Parent?
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  sentMessages   Message[]     @relation("SentMessages")

  @@unique([email])
  @@unique([mobile])
  @@index([institutionId, role])
  @@index([institutionId, status])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 3. ACADEMIC STRUCTURE
// ------------------------------------------------------

model AcademicYear {
  id            String      @id @default(uuid())
  institutionId String
  yearName      String      // e.g. "2025-2026"
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id])
  semesters     Semester[]
  exams         Exam[]
  feeStructures FeeStructure[]

  @@unique([institutionId, yearName])
}

model Department {
  id            String      @id @default(uuid())
  institutionId String
  code          String
  name          String
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id])
  courses       Course[]
  staff         Staff[]
  students      Student[]

  @@unique([institutionId, code])
}

model Course {
  id            String      @id @default(uuid())
  institutionId String
  departmentId  String
  code          String
  name          String      // e.g. "B.Tech Computer Science" or "Class 10"
  durationYears Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id])
  department    Department  @relation(fields: [departmentId], references: [id])
  semesters     Semester[]
  students      Student[]
  subjects      Subject[]
  feeStructures FeeStructure[]

  @@unique([institutionId, code])
}

model Semester {
  id             String       @id @default(uuid())
  courseId       String
  academicYearId String
  name           String       // e.g. "Semester 1" or "Term 1"
  semesterNumber Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  course       Course       @relation(fields: [courseId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  sections     Section[]

  @@unique([courseId, semesterNumber, academicYearId])
}

model Section {
  id         String   @id @default(uuid())
  semesterId String
  name       String   // e.g. "Section A"
  capacity   Int      @default(60)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  semester           Semester            @relation(fields: [semesterId], references: [id])
  students           Student[]
  attendanceSessions AttendanceSession[]
  timetables         Timetable[]
}

model Subject {
  id         String   @id @default(uuid())
  courseId   String
  code       String
  name       String
  type       String   @default("THEORY") // THEORY, PRACTICAL, LAB
  credits    Int      @default(3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course          Course                  @relation(fields: [courseId], references: [id])
  teacherMappings SubjectTeacherMapping[]
  materials       StudyMaterial[]
  questionBanks   QuestionBank[]
  examSchedules   ExamSchedule[]

  @@unique([courseId, code])
}

model SubjectTeacherMapping {
  id        String   @id @default(uuid())
  subjectId String
  staffId   String
  sectionId String?
  createdAt DateTime @default(now())

  subject Subject  @relation(fields: [subjectId], references: [id])
  staff   Staff    @relation(fields: [staffId], references: [id])
}

// ------------------------------------------------------
// 4. STUDENTS & PARENTS
// ------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Student {
  id              String      @id @default(uuid())
  userId          String      @unique
  institutionId   String
  admissionNumber String
  registerNumber  String?
  rollNumber      String?
  firstName       String
  lastName        String
  dob             DateTime
  gender          Gender
  bloodGroup      String?
  email           String
  phone           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  admissionDate   DateTime    @default(now())
  status          String      @default("ACTIVE")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  departmentId String?
  courseId     String?
  semesterId   String?
  sectionId    String?

  // Relations
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution     Institution            @relation(fields: [institutionId], references: [id])
  department      Department?            @relation(fields: [departmentId], references: [id])
  course          Course?                @relation(fields: [courseId], references: [id])
  section         Section?               @relation(fields: [sectionId], references: [id])
  parents         ParentStudent[]
  attendanceRecords AttendanceRecord[]
  leaveRequests   LeaveRequest[]
  submissions     AssignmentSubmission[]
  studentMarks    StudentMark[]
  feeAssignments  StudentFeeAssignment[]
  feePayments     FeePayment[]
  feeReceipts     FeeReceipt[]
  feeChallans     FeeChallan[]
  bookIssues      BookIssue[]
  transport       StudentTransportMapping?
  hostelBed       HostelBed?
  certificates    CertificateRequest[]
  grievances      Grievance[]
  resume          StudentResume?

  @@unique([institutionId, admissionNumber])
  @@index([institutionId, sectionId])
}

model Parent {
  id            String   @id @default(uuid())
  userId        String   @unique
  fatherName    String?
  fatherOccupation String?
  fatherPhone   String?
  motherName    String?
  motherOccupation String?
  motherPhone   String?
  guardianName  String?
  guardianPhone String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  students ParentStudent[]
}

model ParentStudent {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  relation  String   @default("FATHER")

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

// ------------------------------------------------------
// 5. STAFF
// ------------------------------------------------------

model Staff {
  id            String      @id @default(uuid())
  userId        String      @unique
  institutionId String
  employeeCode  String
  departmentId  String?
  designation   String
  qualification String?
  experience    String?
  joiningDate   DateTime    @default(now())
  status        String      @default("ACTIVE")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution           Institution             @relation(fields: [institutionId], references: [id])
  department            Department?             @relation(fields: [departmentId], references: [id])
  subjectTeacherMappings SubjectTeacherMapping[]
  attendanceSessions    AttendanceSession[]
  assignments           Assignment[]
  materials             StudyMaterial[]
  leaveRequests         LeaveRequest[]

  @@unique([institutionId, employeeCode])
  @@index([institutionId, departmentId])
}

// ------------------------------------------------------
// 6. ATTENDANCE & LEAVE
// ------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HALF_DAY
}

model AttendanceSession {
  id            String   @id @default(uuid())
  institutionId String
  sectionId     String
  subjectId     String?
  takenById     String
  date          DateTime
  periodNumber  Int?     @default(1)
  createdAt     DateTime @default(now())

  institution Institution        @relation(fields: [institutionId], references: [id])
  section     Section            @relation(fields: [sectionId], references: [id])
  takenBy     Staff              @relation(fields: [takenById], references: [id])
  records     AttendanceRecord[]

  @@unique([institutionId, sectionId, date, periodNumber])
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  remarks   String?

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id            String      @id @default(uuid())
  institutionId String
  studentId     String?
  staffId       String?
  startDate     DateTime
  endDate       DateTime
  reason        String
  status        LeaveStatus @default(PENDING)
  approvedBy    String?
  attachmentUrl String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])
  student     Student?    @relation(fields: [studentId], references: [id])
  staff       Staff?      @relation(fields: [staffId], references: [id])
}

// ------------------------------------------------------
// 7. TIMETABLE, ASSIGNMENTS & MATERIALS
// ------------------------------------------------------

model Timetable {
  id            String           @id @default(uuid())
  institutionId String
  sectionId     String
  entries       TimetableEntry[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])
  section     Section     @relation(fields: [sectionId], references: [id])
}

model TimetableEntry {
  id          String   @id @default(uuid())
  timetableId String
  dayOfWeek   String   // MONDAY, TUESDAY...
  period      Int
  startTime   String   // "09:00"
  endTime     String   // "10:00"
  subjectName String
  teacherName String
  roomNumber  String?

  timetable Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Assignment {
  id            String           @id @default(uuid())
  institutionId String
  staffId       String
  title         String
  description   String
  subjectName   String
  className     String
  dueDate       DateTime
  totalMarks    Float            @default(100)
  attachmentUrl String?
  status        AssignmentStatus @default(PUBLISHED)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  institution Institution            @relation(fields: [institutionId], references: [id])
  staff       Staff                  @relation(fields: [staffId], references: [id])
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id            String     @id @default(uuid())
  assignmentId  String
  studentId     String
  submittedAt   DateTime   @default(now())
  fileUrl       String?
  content       String?
  marksObtained Float?
  feedback      String?
  status        String     @default("SUBMITTED") // SUBMITTED, REVIEWED, LATE

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model StudyMaterial {
  id            String   @id @default(uuid())
  institutionId String
  staffId       String
  subjectId     String?
  title         String
  description   String?
  fileType      String   // PDF, PPT, DOC, VIDEO
  fileUrl       String
  fileSize      String?
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  staff       Staff       @relation(fields: [staffId], references: [id])
  subject     Subject?    @relation(fields: [subjectId], references: [id])
}

// ------------------------------------------------------
// 8. QUESTION BANK, EXAMS & MARKS
// ------------------------------------------------------

enum QuestionType {
  MCQ
  MULTIPLE_CORRECT
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
  LONG_ANSWER
}

model QuestionBank {
  id            String       @id @default(uuid())
  institutionId String
  subjectId     String
  chapter       String?
  topic         String?
  type          QuestionType @default(MCQ)
  difficulty    String       @default("MEDIUM") // EASY, MEDIUM, HARD
  questionText  String
  explanation   String?
  marks         Float        @default(1)
  options       Json?        // Array of options
  correctAnswer String
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])
  subject     Subject     @relation(fields: [subjectId], references: [id])
}

model Exam {
  id             String   @id @default(uuid())
  institutionId  String
  academicYearId String
  name           String   // e.g. "Mid Term Examination 2026"
  examType       String   // MID_TERM, FINAL, UNIT_TEST
  startDate      DateTime
  endDate        DateTime
  status         String   @default("SCHEDULED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution  Institution    @relation(fields: [institutionId], references: [id])
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])
  schedules    ExamSchedule[]
}

model ExamSchedule {
  id          String   @id @default(uuid())
  examId      String
  subjectId   String
  examDate    DateTime
  startTime   String
  endTime     String
  maxMarks    Float    @default(100)
  passMarks   Float    @default(35)
  roomNumber  String?

  exam        Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject     Subject       @relation(fields: [subjectId], references: [id])
  studentMarks StudentMark[]
}

model StudentMark {
  id             String   @id @default(uuid())
  examScheduleId String
  studentId      String
  marksObtained  Float
  grade          String?
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  examSchedule ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examScheduleId, studentId])
}

// ------------------------------------------------------
// 9. FEES & PAYMENTS
// ------------------------------------------------------

enum FeeCategoryType {
  TUITION_FEE
  EXAM_FEE
  LIBRARY_FEE
  TRANSPORT_FEE
  HOSTEL_FEE
  LAB_FEE
  ADMISSION_FEE
  DEVELOPMENT_FEE
  OTHER_FEE
}

model FeeStructure {
  id             String       @id @default(uuid())
  institutionId String
  academicYearId String
  courseId       String?
  name           String       // e.g. "Annual Fee B.Tech 2026"
  totalAmount    Float
  dueDate        DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  institution  Institution            @relation(fields: [institutionId], references: [id])
  academicYear AcademicYear           @relation(fields: [academicYearId], references: [id])
  course       Course?                @relation(fields: [courseId], references: [id])
  assignments  StudentFeeAssignment[]
}

model StudentFeeAssignment {
  id             String      @id @default(uuid())
  feeStructureId String
  studentId      String
  totalAmount    Float
  discountAmount Float       @default(0)
  paidAmount     Float       @default(0)
  dueAmount      Float
  status         String      @default("PENDING") // PENDING, PARTIAL, PAID
  createdAt      DateTime    @default(now())

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  payments     FeePayment[]
}

enum PaymentMode {
  CASH
  CHEQUE
  DD
  BANK_TRANSFER
  UPI_MANUAL
  RAZORPAY
  ONLINE_CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  SUCCESS
  FAILED
  REJECTED
  REFUNDED
  CANCELLED
}

model FeePayment {
  id                   String        @id @default(uuid())
  institutionId        String
  studentId            String
  studentFeeAssignmentId String
  amountPaid           Float
  paymentMode          PaymentMode   @default(CASH)
  paymentStatus        PaymentStatus @default(SUCCESS)
  transactionReference String?
  bankName             String?
  chequeNumber         String?
  chequeDate           DateTime?
  receivedBy           String?
  remarks              String?
  paidAt               DateTime      @default(now())

  institution          Institution          @relation(fields: [institutionId], references: [id])
  student              Student              @relation(fields: [studentId], references: [id])
  studentFeeAssignment StudentFeeAssignment @relation(fields: [studentFeeAssignmentId], references: [id])
  receipt              FeeReceipt?

  @@index([institutionId, studentId])
}

model FeeReceipt {
  id            String     @id @default(uuid())
  receiptNumber String     @unique
  institutionId String
  studentId     String
  paymentId     String     @unique
  amount        Float
  issuedAt      DateTime   @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])
  payment     FeePayment  @relation(fields: [paymentId], references: [id])
}

model FeeChallan {
  id            String   @id @default(uuid())
  challanNumber String   @unique
  institutionId String
  studentId     String
  amount        Float
  dueDate       DateTime
  bankName      String   @default("State Bank of India")
  status        String   @default("GENERATED")
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])
}

// ------------------------------------------------------
// 10. CAMPUS SERVICES (LIBRARY, TRANSPORT, HOSTEL)
// ------------------------------------------------------

model Book {
  id            String      @id @default(uuid())
  institutionId String
  title         String
  author        String
  isbn          String?
  category      String?
  totalCopies   Int         @default(1)
  availableCopies Int       @default(1)
  createdAt     DateTime    @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  issues      BookIssue[]
}

model BookIssue {
  id         String    @id @default(uuid())
  bookId     String
  studentId  String
  issuedAt   DateTime  @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  fineAmount Float     @default(0)
  status     String    @default("ISSUED")

  book    Book    @relation(fields: [bookId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
}

model Vehicle {
  id            String      @id @default(uuid())
  institutionId String
  vehicleNumber String
  capacity      Int         @default(40)
  driverName    String?
  driverPhone   String?
  createdAt     DateTime    @default(now())

  institution Institution      @relation(fields: [institutionId], references: [id])
  routes      TransportRoute[]
}

model TransportRoute {
  id            String   @id @default(uuid())
  institutionId String
  vehicleId     String?
  routeName     String
  startPoint    String
  endPoint      String
  monthlyFare   Float
  createdAt     DateTime @default(now())

  institution Institution               @relation(fields: [institutionId], references: [id])
  vehicle     Vehicle?                  @relation(fields: [vehicleId], references: [id])
  mappings    StudentTransportMapping[]
}

model StudentTransportMapping {
  id          String   @id @default(uuid())
  studentId   String   @unique
  routeId     String
  pickupPoint String
  createdAt   DateTime @default(now())

  student Student        @relation(fields: [studentId], references: [id])
  route   TransportRoute @relation(fields: [routeId], references: [id])
}

model Hostel {
  id            String       @id @default(uuid())
  institutionId String
  name          String
  type          String       @default("BOYS") // BOYS, GIRLS
  capacity      Int          @default(100)
  createdAt     DateTime     @default(now())

  institution Institution  @relation(fields: [institutionId], references: [id])
  beds        HostelBed[]
}

model HostelBed {
  id         String   @id @default(uuid())
  hostelId   String
  roomNumber String
  bedNumber  String
  studentId  String?  @unique
  isOccupied Boolean  @default(false)
  monthlyFee Float    @default(5000)

  hostel  Hostel   @relation(fields: [hostelId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])
}

// ------------------------------------------------------
// 11. CERTIFICATES, DOCUMENTS, MESSAGES & GRIEVANCES
// ------------------------------------------------------

model CertificateRequest {
  id            String   @id @default(uuid())
  studentId     String
  type          String   // BONAFIDE, TRANSFER, CONDUCT, COURSE_COMPLETION
  reason        String?
  status        String   @default("PENDING") // PENDING, APPROVED, READY, REJECTED
  certificateNo String?
  issuedAt      DateTime?
  createdAt     DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])
}

model Certificate {
  id            String   @id @default(uuid())
  institutionId String
  certificateNo String   @unique
  title         String
  issuedToName  String
  pdfUrl        String?
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
}

model Announcement {
  id            String   @id @default(uuid())
  institutionId String
  title         String
  content       String
  targetRole    String   @default("ALL")
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
}

model Notification {
  id            String   @id @default(uuid())
  institutionId String
  userId        String
  title         String
  message       String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
}

model Event {
  id            String   @id @default(uuid())
  institutionId String
  title         String
  description   String?
  eventDate     DateTime
  venue         String?
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
}

model Club {
  id            String   @id @default(uuid())
  institutionId String
  name          String
  description   String?
  inchargeName  String?
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
}

model Grievance {
  id            String   @id @default(uuid())
  institutionId String
  studentId     String
  subject       String
  description   String
  status        String   @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, RESOLVED
  resolution    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())

  sender User @relation("SentMessages", fields: [senderId], references: [id])
}

model StudentResume {
  id         String   @id @default(uuid())
  studentId  String   @unique
  summary    String?
  skills     Json?    // Array of skills
  projects   Json?    // Array of projects
  updatedAt  DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
}

// ------------------------------------------------------
// 12. AUDIT LOGS & PLATFORM SUBSCRIPTIONS
// ------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  institutionId String?
  userId        String?
  action        String
  module        String
  entity        String?
  entityId      String?
  oldValues     Json?
  newValues     Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])

  @@index([institutionId, createdAt])
}

model SubscriptionPlan {
  id           String         @id @default(uuid())
  name         String         // BASIC, STANDARD, ENTERPRISE
  priceMonthly Float
  priceYearly  Float
  maxStudents  Int            @default(500)
  maxStaff     Int            @default(50)
  features     Json?
  createdAt    DateTime       @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id            String   @id @default(uuid())
  institutionId String
  planId        String
  startDate     DateTime
  endDate       DateTime
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())

  institution Institution      @relation(fields: [institutionId], references: [id])
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  institutionId String
  amount        Float
  status        String   @default("PAID") // PAID, PENDING, OVERDUE
  dueDate       DateTime
  paidAt        DateTime?
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
}
