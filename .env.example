# SCOMS Platform Environment Variables Configuration Example

# Server Environment & Port Configuration
NODE_ENV=development
SUPER_ADMIN_PORT=5001
INSTITUTE_ADMIN_PORT=5002
STAFF_PORT=5003
STUDENT_PORT=5004
MOBILE_PORT=5005

# Module Registry (Phase 1) — leave unset/false. Every institution keeps running on the
# existing Institution.modules array either way; this only allows an institution to be
# explicitly opted into the new registry once real InstitutionModuleAssignment rows
# exist for it. See shared/moduleRegistry/resolveModules.js.
MODULE_REGISTRY_ENABLED=false

# RBAC Enforcement (Phase 3) — leave unset/false. shadowPermission() logs would-be
# denies instead of blocking until this is explicitly set true. See
# shared/middleware/shadowPermission.js.
RBAC_ENFORCEMENT_ENABLED=false

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scoms_db?schema=public"
# Direct (non-pooled) connection used by `prisma migrate`. Locally: same as DATABASE_URL.
# Supabase: DATABASE_URL = Transaction pooler (port 6543) + "?pgbouncer=true",
#           DIRECT_URL   = Direct connection (port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/scoms_db?schema=public"

# Comma-separated frontend URLs each backend accepts requests from (production only).
# Leave unset locally to allow all origins.
# CORS_ORIGINS="https://scoms-admin.vercel.app,https://scoms-staff.vercel.app"

# Centralized JWT Secrets & Expiry
JWT_ACCESS_SECRET="scoms_super_secret_access_key_2026_prod"
JWT_REFRESH_SECRET="scoms_super_secret_refresh_key_2026_prod"
JWT_ACCESS_EXPIRES="1d"
JWT_REFRESH_EXPIRES="7d"

# Redis Connection URL (for Queue & Caching)
REDIS_URL="redis://localhost:6379"

# Email SMTP Settings (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@scoms.in"
SMTP_PASSWORD="your-app-password"

# SMS Gateway (TRAI DLT Compliant Provider - e.g. Fast2SMS / TextLocal)
SMS_API_KEY="your-sms-api-key"
SMS_SENDER_ID="SCOMSM"

# WhatsApp Business Cloud API
WHATSAPP_API_KEY="your-whatsapp-api-key"
WHATSAPP_PHONE_NUMBER_ID="10928471928"

# Razorpay Online Fee Payment Gateway
RAZORPAY_KEY_ID="rzp_test_key"
RAZORPAY_KEY_SECRET="rzp_test_secret"

# Storage Provider Configuration (AWS S3 / Cloudinary / DigitalOcean Spaces)
STORAGE_PROVIDER="S3"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_BUCKET="scoms-documents"
STORAGE_REGION="ap-south-1"

# AI Provider API Key (OpenAI / Gemini)
AI_API_KEY="your-ai-api-key"

# Mobile Push Notifications (FCM) — leave FIREBASE_SERVICE_ACCOUNT_JSON unset and every
# push is simulated (logged, not dispatched) instead of failing, same as the email/SMS/
# WhatsApp channels above. INTERNAL_PUSH_SECRET authenticates the server-to-server call
# every backend's shared/utils/notificationCenter.js makes to the mobile gateway's
# /internal/push/dispatch route — it is never sent to any client. See
# scoms-app-backend/src/modules/pushNotifications/.
MOBILE_BACKEND_INTERNAL_URL="http://localhost:5005"
INTERNAL_PUSH_SECRET="change-this-to-a-long-random-value"
FIREBASE_SERVICE_ACCOUNT_JSON=
