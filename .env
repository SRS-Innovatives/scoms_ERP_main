# SCOMS Platform Environment Variables Configuration
#
# LIVE vs SIMULATED: every external integration below follows the same rule — as long as
# a real value replaces the "your-..." / test placeholder shown here, that channel goes
# live automatically on the next backend restart. No code changes needed. Until then, the
# app keeps working normally with every send/charge clearly logged as SIMULATED (visible
# in Super Admin → System Health, and in each channel's usage/log dashboard) instead of
# silently failing or pretending to succeed.

# Server Environment & Port Configuration
NODE_ENV=development
SUPER_ADMIN_PORT=5001
INSTITUTE_ADMIN_PORT=5002
STAFF_PORT=5003
STUDENT_PORT=5004

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:password@localhost:5432/scoms_db?schema=public"

# Centralized JWT Secrets & Expiry
JWT_ACCESS_SECRET="scoms_super_secret_access_key_2026_prod"
JWT_REFRESH_SECRET="scoms_super_secret_refresh_key_2026_prod"
JWT_ACCESS_EXPIRES="1d"
JWT_REFRESH_EXPIRES="7d"

# --- Email (Nodemailer / SMTP) --------------------------------------------------------
# LIVE as soon as SMTP_HOST/SMTP_USER/SMTP_PASSWORD are all real (not the placeholders
# below, and not an @example.com/@scoms.in address). Any real SMTP provider works —
# Gmail App Password, SendGrid, Amazon SES, your own mail server, etc.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@scoms.in"
SMTP_PASSWORD="your-app-password"

# --- SMS (Fast2SMS) ---------------------------------------------------------------------
# LIVE as soon as SMS_API_KEY is a real Fast2SMS API key (get one at fast2sms.com).
# SMS_SENDER_ID is your registered TRAI DLT sender ID — required in India for template SMS.
SMS_API_KEY="your-sms-api-key"
SMS_SENDER_ID="SCOMSM"

# --- WhatsApp (Meta WhatsApp Business Cloud API) -----------------------------------------
# LIVE as soon as WHATSAPP_ACCESS_TOKEN is a real permanent access token from your Meta
# App (developers.facebook.com → your app → WhatsApp → API Setup) and
# WHATSAPP_PHONE_NUMBER_ID is the Phone Number ID shown on that same page.
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"

# --- Razorpay (Online Fee Payment Gateway) -----------------------------------------------
# LIVE as soon as RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET are your real Razorpay API keys
# (dashboard.razorpay.com → Settings → API Keys). Once live, real orders are created via
# Razorpay's Orders API and the Student portal opens the actual Razorpay Checkout widget —
# no other setup needed.
RAZORPAY_KEY_ID="rzp_test_key"
RAZORPAY_KEY_SECRET="rzp_test_secret"

# --- AI Study Tutor (OpenAI) --------------------------------------------------------------
# NOT configured here — the AI Tutor's API key is set from inside the app instead
# (Super Admin → AI Configuration), because it's billed per-institution and Super Admin
# needs to pick the model/temperature alongside it. Nothing to do in this file for AI.

# --- Not yet wired to any feature ---------------------------------------------------------
# These are present for future use but no current SCOMS feature reads them yet — pasting
# real values here will not turn anything on:
#   REDIS_URL            — no caching/queue system exists in this codebase yet.
#   STORAGE_* (S3/etc.)  — file uploads (bulk admission sheets, etc.) are parsed in-memory
#                          and never persisted to disk/cloud, so there is nothing to point
#                          at a bucket. Ask if you want real file storage (e.g. ID photos,
#                          document uploads) built — that's a real feature to add, not a
#                          config flip.
REDIS_URL="redis://localhost:6379"
STORAGE_PROVIDER="S3"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_BUCKET="scoms-documents"
STORAGE_REGION="ap-south-1"
